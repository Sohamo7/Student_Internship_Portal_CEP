# =============================================================================
# NGO Internship Portal — environment variables
# Local:  copy this file to .env.local and fill it in.
# Vercel: add the same names under Project → Settings → Environment Variables
#         (enter values WITHOUT surrounding quotes there).
#
# NOTE: NEXT_PUBLIC_* values are baked into the site at BUILD time. Changing
# one on Vercel has no effect until you redeploy.
# =============================================================================

# --- REQUIRED for a real deployment ------------------------------------------
# Supabase Dashboard → Project Settings → API.
# Safe to expose to the browser (data is protected by Row Level Security).
# If these are missing, the app runs in offline DEMO mode (fake accounts, data
# in the browser's localStorage). A production build on Vercel refuses to
# proceed without them (see next.config.ts).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- REQUIRED for the Admin Team (invite another admin) feature ---------------
# Supabase → Project Settings → API → "service_role" key.
# SERVER-ONLY SECRET: bypasses all security rules. Never prefix with
# NEXT_PUBLIC_, never commit it, never paste it into client code.
# Without it, everything else works but invites are disabled.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site (no trailing slash), used for the link inside
# invite emails, e.g. https://your-portal.vercel.app
# Falls back to the request's own origin if blank. Also add
# <this URL>/accept-invite to Supabase → Authentication → URL Configuration →
# Redirect URLs, or invite links won't return to the portal.
NEXT_PUBLIC_SITE_URL=

# --- RECOMMENDED: automated email (Resend) -----------------------------------
# https://resend.com/api-keys
# If RESEND_API_KEY is blank the app still works — emails are only logged on the
# server, and the Admin Team page shows invite links to send by hand.
RESEND_API_KEY=
# The default resend.dev sender can ONLY deliver to your own Resend account
# email (fine for testing). To email real applicants, verify a domain in Resend
# and use an address on it, e.g. "NGO Portal <noreply@yourngo.org>".
RESEND_FROM_EMAIL="NGO Portal <onboarding@resend.dev>"

# --- OPTIONAL ----------------------------------------------------------------
# Deliberately deploy the public demo build (fake accounts, one-click admin)
# to Vercel Production without Supabase. Leave unset for a real deployment.
# ALLOW_DEMO_BUILD=true
