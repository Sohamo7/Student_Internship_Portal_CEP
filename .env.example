# =============================================================================
# NGO Internship Portal — Production Environment Variables
# Local:  copy this file to .env.local and fill in your Supabase credentials.
# Vercel: add the same names under Project → Settings → Environment Variables
#         (enter values WITHOUT surrounding quotes there).
#
# NOTE: NEXT_PUBLIC_* values are baked into the site at BUILD time. Changing
# one on Vercel requires redeploying to take effect.
# =============================================================================

# --- REQUIRED: Active Supabase Project Credentials ----------------------------
# Found in: Supabase Dashboard → Project Settings → API
# Safe to expose to the browser (all tables protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-actual-anon-key-here

# --- REQUIRED for Admin Team Invites & Server Verification -------------------
# Supabase Dashboard → Project Settings → API → "service_role" secret key.
# SERVER-ONLY SECRET: bypasses all RLS rules. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-actual-service-role-key-here

# --- PUBLIC PORTAL URL --------------------------------------------------------
# Public URL of the deployed site (no trailing slash), e.g. https://your-portal.vercel.app
# Also add <this URL>/accept-invite to Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OPTIONAL: NGO Site Geolocation & Attendance Geofence --------------------
# Base coordinates of your NGO center/site used to calculate distance and verify
# attendance check-ins. If unset, defaults to Delhi HQ coordinates (28.6139, 77.2090).
NEXT_PUBLIC_NGO_SITE_LATITUDE=28.6139
NEXT_PUBLIC_NGO_SITE_LONGITUDE=77.2090
# Radius in meters within which a check-in is considered "on site" (default: 500m)
NEXT_PUBLIC_NGO_GEOFENCE_RADIUS_METERS=500

# --- RECOMMENDED: Automated Email via Resend ----------------------------------
# Get API key from: https://resend.com/api-keys
# Used for welcome emails, status decisions, and admin invitations.
RESEND_API_KEY=
# Verified sender address or domain on Resend (e.g. "NGO Portal <noreply@yourngo.org>")
RESEND_FROM_EMAIL="NGO Portal <onboarding@resend.dev>"
